set default="0"

function load_video {
  insmod all_video
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod chain

set timeout=10

search --no-floppy --set=root --fs-uuid @ISO_UUID@

menuentry '@PRETTY_NAME@ Live ISO' --class fedora --class gnu-linux --class gnu --class os {
  linux ($root)/boot/vmlinuz quiet rhgb root=live:UUID=@ISO_UUID@ enforcing=0 rd.live.image rd.live.check @EXTRA_KARGS@
  initrd ($root)/boot/initramfs.img
}

